{
  "kind": "collectionType",
  "collectionName": "products",
  "info": {
    "singularName": "product",
    "pluralName": "products",
    "displayName": "Product"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "itemName": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "text",
      "required": false
    },
    "price": {
      "type": "integer",
      "required": true
    },
    "quantity": {
      "type": "integer",
      "required": true
    },
    "imagesUrl": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images"
      ]
    },
    "salePercent": {
      "type": "integer"
    },
    "category": {
      "type": "enumeration",
      "enum": [
        "All",
        "Bakery",
        "Beverages",
        "Dairy",
        "Fruits",
        "Snacks",
        "Spices",
        "Vegetables"
      ]
    }
  }
}
